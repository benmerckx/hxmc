# The site's JavaScript (`make site`): one file per page script, into
# bin/site, compiled by the port. Run from the repository root.
-cp site/client
-dce full
-D js-es=6
--each

# the playground's page and its compiler's worker
--main Playground
--js bin/site/playground.js

--next
--main Worker
--js bin/site/worker.js

# the benchmarks page's tables
--next
--main Tables
--js bin/site/tables.js

# the build facts on the other pages
--next
--main Info
--js bin/site/info.js
