// title: Showroom
// summary: @hxmc/3d's optional renderer features together: an environment map lighting metal and plastic spheres, a normal-mapped crate, a morphing surface, two shadow cascades, see-through glass; drag to turn around
// tags: 3d, pbr, gltf
// demo: canvas 512x384
import hxmc.gfx.*;
import hxmc.gfx.shader.Vec3;
import hxmc.gfx.shader.Vec4;
import hxmc.os.*;
import hxmc.scene.*;
import hxmc.scene.anim.*;
import hxmc.scene.gltf.*;
import hxmc.scene.math.*;
import hxmc.scene.render.*;

// Each optional feature turned on with renderer.use: an Environment from
// an equirectangular PNG (panorama.png, generated by
// packages/3d/test/SampleModel.hx) behind the scene and lighting it,
// NormalMaps for normals.glb's crate (its tangents computed when loaded),
// Shadows.cascaded; morph.glb's surface plays its weights; a pane of glass
// is a blended material. Images decode through @hxmc/ui's PNG decoder,
// named here. Drag sideways to turn; Escape closes.
//
//   haxe -cp packages/os/src -cp packages/gfx/src -cp packages/text/src -cp packages/ui/src -cp packages/3d/src
//     -cp packages/3d/examples -main Showroom --custom-target hxmc=showroom -D hxmc.libc=glibc
class Showroom {
	static function main() {
		var window = new Window("Showroom", 640, 480);
		var device = Device.create(window.surface);
		Images.decode = (mime, bytes) -> hxmc.ui.PngDecoder.decode(bytes);
		var renderer = new Renderer(device).use(new NormalMaps(device)).use(Shadows.cascaded(device, 1024, 6));
		var env = Environment.fromImage(device, "image/png", Asset.embed("panorama.png"));
		if (env != null) renderer.use(env);
		var world = new World();
		var floor = world.node("floor");
		MeshRenderer.attach(floor, Shapes.box(device, new Material("floor", new Vec4(0.55, 0.55, 0.58, 1), 0, 0.7), 12, 0.2, 12));
		floor.position = new Vec3(0, -0.1, 0);
		for (k in 0...4) {
			var rough = 0.05 + k * 0.3;
			var metal = world.node("metal"), plastic = world.node("plastic");
			metal.position = new Vec3(-2.1 + k * 1.4, 0.5, -1.6);
			plastic.position = new Vec3(-2.1 + k * 1.4, 0.5, -3);
			MeshRenderer.attach(metal, Shapes.sphere(device, new Material("metal", new Vec4(0.95, 0.9, 0.8, 1), 1, rough), 0.5, 32, 16));
			MeshRenderer.attach(plastic, Shapes.sphere(device, new Material("plastic", new Vec4(0.8, 0.2, 0.15, 1), 0, rough), 0.5, 32, 16));
		}
		var crate = Model.of("normals.glb");
		var tiles = crate.instantiate(world, device).find(crate.nodes.tiles);
		tiles.position = new Vec3(-1.6, 0.6, 0.6);
		var morph = Model.of("morph.glb");
		var made = [];
		var blob = morph.instantiate(world, device, null, made);
		blob.position = new Vec3(1.4, 0.3, 0.6);
		var animator = new Animator(made);
		animator.play(morph.clip(morph.animations.breathe), {loop: true});
		var glass = new Material("glass", new Vec4(0.3, 0.6, 1, 0.35), 0, 0.05, null, true);
		glass.blend = true;
		var pane = world.node("pane");
		pane.position = new Vec3(0, 0.8, 1.8);
		MeshRenderer.attach(pane, Shapes.box(device, glass, 1.6, 1.6, 0.04));
		var sun = world.node("sun");
		Light.attach(sun, Light.directional(new Vec3(1, 0.95, 0.85), 2.2));
		sun.lookAt(new Vec3(0.35, -0.45, 0.82));
		var rig = world.node("rig");
		var eye = world.node("eye", rig);
		eye.position = new Vec3(0, 2.2, 6.5);
		eye.lookAt(new Vec3(0, 0.6, 0));
		var camera = Camera.attach(eye, Camera.perspective(0.8, 0.1, 60));
		var clock = new FixedStep(1 / 60);
		var turn = 0.0, drag = false, from = 0, last = Sys.time();
		HotWorld.keep(world, "showroom.world");
		App.run(() -> {
			var now = Sys.time();
			clock.advance(Math.min(now - last, 0.25), dt -> {
				animator.update(dt);
				tiles.rotation = Quat.fromEuler(0.3, clock.time * 0.5, 0);
				if (!drag) turn += 0.1 * dt;
			});
			last = now;
			rig.rotation = Quat.axisAngle(new Vec3(0, 1, 0), turn);
			var enc = device.beginFrame();
			if (enc == null) return;
			renderer.draw(enc, world, camera);
			device.endFrame();
		}, e -> switch e.kind {
			case Close: window.close();
			case KeyDown if (e.key == 0xFF1B): window.close();
			case MouseDown if (e.button == 1):
				drag = true;
				from = e.x;
			case MouseUp if (e.button == 1):
				drag = false;
			case MouseMove if (drag):
				turn -= (e.x - from) / window.width * Math.PI;
				from = e.x;
			case _:
		});
	}
}
