{
  "name": "@hxmc/haxe",
  "version": "0.1.0",
  "description": "The Haxe compiler ported to Haxe: native executables for Linux, macOS and Windows (x86-64, ARM64) and WebAssembly, for every Haxe target (js, hl, jvm, ...); @hxmc/cli adds hxmc's native target",
  "type": "module",
  "bin": {
    "haxe": "hxmc/bootstrap/haxe"
  },
  "scripts": {
    "postinstall": "node hxmc/bootstrap/postinstall.mjs"
  },
  "files": [
    "haxe/upstream/std/",
    "haxe/upstream/LICENSE",
    "hxmc/bootstrap/haxe",
    "hxmc/bootstrap/haxe.mjs",
    "hxmc/bootstrap/launcher.mjs",
    "hxmc/bootstrap/dev.mjs",
    "hxmc/bootstrap/platforms.mjs",
    "hxmc/bootstrap/postinstall.mjs",
    "hxmc/bootstrap/registry.mjs",
    "hxmc/bootstrap/wasm.mjs",
    "dist/haxe",
    "COPYING",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@hxmc/haxe-linux-x64": "{version}",
    "@hxmc/haxe-linux-arm64": "{version}",
    "@hxmc/haxe-darwin-x64": "{version}",
    "@hxmc/haxe-darwin-arm64": "{version}",
    "@hxmc/haxe-win32-x64": "{version}",
    "@hxmc/haxe-win32-arm64": "{version}"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ]
}
