package ml2hx.rt;

// OCaml 3-tuple. Generated by the emitter's contract (README): fields v0..v2.
class Tuple3<T0, T1, T2> implements Structural {
	public final v0:T0;
	public final v1:T1;
	public final v2:T2;
	public inline function new(v0:T0, v1:T1, v2:T2) {
		this.v0 = v0;
		this.v1 = v1;
		this.v2 = v2;
	}
	public function structuralFields():Array<Any> return [v0, v1, v2];
}
