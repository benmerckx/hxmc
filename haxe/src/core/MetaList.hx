	CallSuper;
	Commutative;
	CompilerGenerated;
	Const;
	CoreApi;
	CoreType;
	Coroutine;
	CoroutineScope;
	CppFileCode;
	CppInclude;
	CppNamespaceCode;
	Dce;
	Debug;
	Decl;
	DefParam;
	Depend;
	Deprecated;
	DirectlyUsed;
	DisplayOverride;
	Eager;
	Enum;
	Exhaustive;
	Expose;
	Extern;
	File;
	FileXml;
	Final;
	Fixed;
	FlashProperty;
	FlatEnum;
	Font;
	ForLoopVariable;
	Forward;
	ForwardNew;
	ForwardStatics;
	ForwardVariance;
	From;
	FromNull;
	FunctionalInterface;
	FunctionCode;
	FunctionTailCode;
	Generic;
	GenericBuild;
	GenericInstance;
	GenericClassPerMethod;
	Getter;
	Hack;
	HasUntyped;
	HeaderClassCode;
	HeaderCode;
	HeaderInclude;
	HeaderNamespaceCode;
	HlNative;
	HxbId;
	HxCompletion;
	HxGen;
	IfFeature;
	PythonImport;
	ImplicitCast;
	ImplicitReturn;
	Include;
	InheritDoc;
	InitPackage;
	Inline;
	InlineConstructorArgument(variable:Int, index:Int);
	InlineObject;
	IsVar;
	JavaDefault;
	JvmSynthetic;
	JsRequire;
	JsImport;
	LuaRequire;
	LuaDotMethod;
	Keep;
