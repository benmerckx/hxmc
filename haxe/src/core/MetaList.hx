class MetaList {
	public static function parseMetaUsage(value:String):MetaUsage return switch value {
		case "TClass": TClass;
		case "TClassField": TClassField;
		case "TAbstract": TAbstract;
		case "TAbstractField": TAbstractField;
		case "TEnum": TEnum;
		case "TTypedef": TTypedef;
		case "TAnyField": TAnyField;
		case "TExpr": TExpr;
		case "TTypeParameter": TTypeParameter;
		case "TVariable": TVariable;
		case _: throw "invalid metadata target " + value;
	};

	public static function printMetaUsage(value:MetaUsage):String return StdType.enumConstructor(value);

	public static function getInfo(meta:StrictMeta):{name:String, doc:String, flags:Array<MetaParameter>}
		return switch meta {
			case Abi: {name: ":abi", doc: "Function ABI/calling convention.", flags: [Platforms([Cpp])]};
			case Access: {
					name: ":access",
					doc: "Forces private access to package, type or field.",
					flags: [
						HasParam("Target path"),
						UsedOn([TClass, TClassField]),
						Link("https://haxe.org/manual/lf-access-control.html")
					]
				};
			case Accessor: {
					name: ":accessor",
					doc: "Used internally by DCE to mark property accessors.",
					flags: [UsedOn([TClassField]), UsedInternally]
				};
			case Allow: {
					name: ":allow",
					doc: "Allows private access from package, type or field.",
					flags: [HasParam("Target path"), Link("https://haxe.org/manual/lf-access-control.html")]
				};
			case Analyzer: {name: ":analyzer", doc: "Used to configure the static analyzer.", flags: [Link("https://haxe.org/manual/cr-static-analyzer.html")]};
			case Annotation: {
					name: ":annotation",
					doc: "Marks a class as a Java annotation",
					flags: [Platforms([Jvm]), HasParam("Retention policy"), UsedOn([TClass])]
				};
			case ArrayAccess: {
					name: ":arrayAccess",
					doc: "Allows array access on an abstract.",
					flags: [
						UsedOn([TAbstract, TAbstractField]),
						Link("https://haxe.org/manual/types-abstract-array-access.html")
					]
				};
			case Ast: {name: ":ast", doc: "Internally used to pass the AST source into the typed AST.", flags: [UsedInternally]};
			case AstSource: {
					name: ":astSource",
					doc: "Filled by the compiler with the parsed expression of the field.",
					flags: [UsedOn([TClassField])]
				};
			case AutoBuild: {
					name: ":autoBuild",
					doc: "Extends `@:build` metadata to all extending and implementing classes.",
					flags: [
						HasParam("Build macro call"),
						UsedOn([TClass]),
						Link("https://haxe.org/manual/macro-auto-build.html")
					]
				};
			case Bind: {name: ":bind", doc: "Override SWF class declaration.", flags: [Platforms([Flash]), UsedOn([TClass])]};
			case Bitmap: {
					name: ":bitmap",
					doc: "Embeds given bitmap data into the class (must extend `flash.display.BitmapData`).",
					flags: [
						Platforms([Flash]),
						HasParam("Bitmap file path"),
						UsedOn([TClass]),
						Link("https://haxe.org/manual/target-flash-resources.html")
					]
				};
			case Build: {
					name: ":build",
					doc: "Builds a class, enum, or abstract from a macro.",
					flags: [
						HasParam("Build macro call"),
						UsedOn([TClass, TEnum, TAbstract]),
						Link("https://haxe.org/manual/macro-type-building.html")
					]
				};
			case BuildXml: {name: ":buildXml", doc: "Specify XML data to be injected into `Build.xml`.", flags: [Platforms([Cpp])]};
			case BypassAccessor: {
					name: ":bypassAccessor",
					doc: "Do not call property accessor method and access the field directly.",
					flags: [UsedOn([TExpr]), Link("https://haxe.org/manual/class-field-property.html")]
				};
			case Callable: {name: ":callable", doc: "Abstract forwards call to its underlying type.", flags: [UsedOn([TAbstract])]};
			case CallSuper: {name: ":callSuper", doc: "Requires the overriding method to call super.", flags: [UsedOn([TClassField])]};
			case Commutative: {
					name: ":commutative",
					doc: "Declares an abstract operator as commutative.",
					flags: [
						UsedOn([TAbstractField]),
						Link("https://haxe.org/manual/types-abstract-operator-overloading.html")
					]
				};
			case CompilerGenerated: {
					name: ":compilerGenerated",
					doc: "Marks a field as generated by the compiler. Should not be used by the end user.",
					flags: [UsedInternally]
				};
			case Const: {name: ":const", doc: "Allows a type parameter to accept expression values.", flags: [UsedOn([TTypeParameter])]};
			case CoreApi: {
					name: ":coreApi",
					doc: "Identifies this class as a core API class. Accepts optional `check = On | Off | Implied` configuration.",
					flags: [UsedOn([TClass, TEnum, TTypedef, TAbstract])]
				};
			case CoreType: {
					name: ":coreType",
					doc: "Identifies an abstract as core type so that it requires no implementation.",
					flags: [
						UsedOn([TAbstract]),
						Link("https://haxe.org/manual/types-abstract-core-type.html")
					]
				};
			case Coroutine: {name: ":coroutine", doc: "Transform function into a coroutine", flags: [UsedOn([TClassField])]};
			case CoroutineScope: {
					name: ":coroutine.scope",
					doc: "Marks a type as a coroutine scope, disallowing its usage in other scopes. Use @:coroutine.scope(restrictedSuspension) to allow only coroutines defined on this scope to be called.",
					flags: [UsedOn([TClass, TEnum, TTypedef, TAbstract])]
				};
			case CppFileCode: {name: ":cppFileCode", doc: "Code to be injected into generated cpp file.", flags: [Platforms([Cpp])]};
			case CppInclude: {name: ":cppInclude", doc: "File to be included in generated cpp file.", flags: [Platforms([Cpp])]};
			case CppNamespaceCode: {name: ":cppNamespaceCode", doc: "", flags: [Platforms([Cpp])]};
			case Dce: {
					name: ":dce",
					doc: "Forces dead code elimination even when `--dce full` is not specified.",
					flags: [
						UsedOn([TClass, TEnum, TClassField]),
						Link("https://haxe.org/manual/cr-dce.html")
					]
				};
			case Debug: {
					name: ":debug",
					doc: "Forces debug information to be generated into the SWF even without `--debug`.",
					flags: [Platforms([Flash]), UsedOn([TClass, TClassField])]
				};
			case Decl: {name: ":decl", doc: "", flags: [Platforms([Cpp])]};
			case DefParam: {
					name: ":defParam",
					doc: "Default function argument value loaded from the SWF and used for documentation in Genxml.",
					flags: [Platforms([Flash]), UsedInternally]
				};
			case Depend: {name: ":depend", doc: "", flags: [Platforms([Cpp])]};
			case Deprecated: {name: ":deprecated", doc: "Mark a type or field as deprecated.", flags: []};
			case DirectlyUsed: {
					name: ":directlyUsed",
					doc: "Marks types that are directly referenced by non-extern code.",
					flags: [UsedInternally]
				};
			case DisplayOverride: {
					name: ":?display.override",
					doc: "Internally used to mark override fields for completion",
					flags: [UsedInternally]
				};
			case Eager: {name: ":eager", doc: "Forces typedefs to be followed early.", flags: [UsedOn([TTypedef])]};
			case Enum: {
					name: ":enum",
					doc: "Defines finite value sets to abstract definitions.",
					flags: [UsedOn([TAbstract]), Link("https://haxe.org/manual/types-abstract-enum.html")]
				};
			case Exhaustive: {
					name: ":exhaustive",
					doc: "Used internally to mark that a switch is exhaustive.",
					flags: [
						UsedInternally,
						Link("https://haxe.org/manual/lf-pattern-matching-exhaustiveness.html")
					]
				};
			case Expose: {
					name: ":expose",
					doc: "Includes the class or field in Haxe exports (default name is the classpath).",
					flags: [
						Platforms([Js, Lua]),
						HasParam("name"),
						Link("https://haxe.org/manual/target-javascript-expose.html")
					]
				};
			case Extern: {name: ":extern", doc: "Marks the field as extern so it is not generated.", flags: [UsedOn([TClassField])]};
			case File: {
					name: ":file",
					doc: "Includes a given binary file into the target SWF and associates it with the class (must extend `flash.utils.ByteArray`).",
					flags: [
						Platforms([Flash]),
						HasParam("File path"),
						UsedOn([TClass]),
						Link("https://haxe.org/manual/target-flash-resources.html")
					]
				};
			case FileXml: {
					name: ":fileXml",
					doc: "Include a given XML attribute snippet in the `Build.xml` entry for the file.",
					flags: [Platforms([Cpp]), UsedOn([TClass])]
				};
			case Final: {
					name: ":final",
					doc: "Prevents a class or interface from being extended or a method from being overridden. Deprecated by the keyword `final`.",
					flags: [
						UsedOn([TClass, TClassField]),
						Link("https://haxe.org/manual/class-field-final.html")
					]
				};
			case Fixed: {name: ":fixed", doc: "Declares an anonymous object to have fixed fields.", flags: []};
			case FlashProperty: {name: ":flash.property", doc: "", flags: [Platforms([Flash]), UsedOn([TClassField])]};
			case FlatEnum: {
					name: ":flatEnum",
					doc: "Internally used to mark an enum as being flat, i.e. having no function constructors.",
					flags: [UsedOn([TEnum]), UsedInternally]
				};
			case Font: {
					name: ":font",
					doc: "Embeds the given TrueType font into the class (must extend `flash.text.Font`).",
					flags: [
						HasParam("TTF path"),
						HasParam("Range String"),
						UsedOn([TClass]),
						Link("https://haxe.org/manual/target-flash-resources.html")
					]
				};
			case ForLoopVariable: {name: ":forLoopVariable", doc: "Internally used to mark for-loop variables.", flags: [UsedInternally]};
			case Forward: {
					name: ":forward",
					doc: "Forwards field access to underlying type.",
					flags: [
						HasParam("List of field names"),
						UsedOn([TAbstract]),
						Link("https://haxe.org/manual/types-abstract-forward.html")
					]
				};
			case ForwardNew: {name: ":forward.new", doc: "Forwards constructor call to underlying type.", flags: [UsedOn([TAbstract])]};
			case ForwardStatics: {
					name: ":forwardStatics",
					doc: "Forwards static field access to underlying type.",
					flags: [
						HasParam("List of field names"),
						UsedOn([TAbstract]),
						Link("https://haxe.org/manual/types-abstract-forward.html")
					]
				};
			case ForwardVariance: {
					name: ":forward.variance",
					doc: "Forwards variance unification to underlying type.",
					flags: [UsedOn([TAbstract])]
				};
			case From: {
					name: ":from",
					doc: "Specifies that the field of the abstract is a cast operation from the type identified in the function.",
					flags: [
						UsedOn([TAbstractField]),
						Link("https://haxe.org/manual/types-abstract-implicit-casts.html")
					]
				};
			case FromNull: {
					name: ":fromNull",
					doc: "Allows implicit use of `null` as underlying value; static targets will convert it to the default value. For abstracts over basic types only.",
					flags: [UsedOn([TAbstract])]
				};
			case FunctionalInterface: {
					name: ":functionalInterface",
					doc: "Mark an interface as a functional interface",
					flags: [Platforms([Jvm])]
				};
			case FunctionCode: {
					name: ":functionCode",
					doc: "Used to inject platform-native code into a function.",
					flags: [Platforms([Cpp])]
				};
			case FunctionTailCode: {name: ":functionTailCode", doc: "", flags: [Platforms([Cpp])]};
			case Generic: {
					name: ":generic",
					doc: "Marks a class or class field as generic so each type parameter combination generates its own type/field.",
					flags: [Link("https://haxe.org/manual/type-system-generic.html")]
				};
			case GenericBuild: {
					name: ":genericBuild",
					doc: "Builds instances of a type using the specified macro.",
					flags: [UsedOn([TClass])]
				};
			case GenericInstance: {
					name: ":genericInstance",
					doc: "Internally used to mark instances of `@:generic` methods.",
					flags: [UsedOn([TClassField]), UsedInternally]
				};
			case GenericClassPerMethod: {
					name: ":genericClassPerMethod",
					doc: "Makes compiler generate separate class per generic static method specialization",
					flags: [UsedOn([TClass])]
				};
			case Getter: {
					name: ":getter",
					doc: "Generates a native getter function on the given field.",
					flags: [Platforms([Flash]), HasParam("Class field name"), UsedOn([TClassField])]
				};
			case Hack: {
					name: ":hack",
					doc: "Allows extending classes marked as `@:final`. Not guaranteed to work on all targets.",
					flags: [UsedOn([TClass])]
				};
			case HasUntyped: {
					name: ":has_untyped",
					doc: "Used by the typer to mark fields that have untyped expressions.",
					flags: [UsedInternally]
				};
			case HeaderClassCode: {
					name: ":headerClassCode",
					doc: "Code to be injected into the generated class, in the header.",
					flags: [Platforms([Cpp])]
				};
			case HeaderCode: {name: ":headerCode", doc: "Code to be injected into the generated header file.", flags: [Platforms([Cpp])]};
			case HeaderInclude: {name: ":headerInclude", doc: "File to be included in generated header file.", flags: [Platforms([Cpp])]};
			case HeaderNamespaceCode: {name: ":headerNamespaceCode", doc: "", flags: [Platforms([Cpp])]};
			case HlNative: {
					name: ":hlNative",
					doc: "Specifies `hdll` name and function prefix for native functions.",
					flags: [Platforms([Hl]), UsedOn([TClass, TClassField])]
				};
			case HxbId: {name: ":hxb.id", doc: "Internally used by hxb", flags: [UsedInternally]};
			case HxCompletion: {name: ":hx.completion", doc: "Internally used for completion", flags: [UsedInternally]};
			case HxGen: {name: ":hxGen", doc: "Annotates that an extern class was generated by Haxe.", flags: [UsedOn([TClass, TEnum])]};
			case IfFeature: {
					name: ":ifFeature",
					doc: "Causes a field to be kept by DCE if the given feature is part of the compilation.",
					flags: [
						HasParam("Feature name"),
						UsedOn([TClassField]),
						Link("https://haxe.org/manual/cr-dce.html")
					]
				};
			case PythonImport: {
					name: ":pythonImport",
					doc: "Generates python import statement for extern classes.",
					flags: [Platforms([Python]), UsedOn([TClass])]
				};
			case ImplicitCast: {
					name: ":implicitCast",
					doc: "Generated automatically on the AST when an implicit abstract cast happens.",
					flags: [UsedOn([TExpr]), UsedInternally]
				};
			case ImplicitReturn: {
					name: ":implicitReturn",
					doc: "Generated automatically on the AST when an implicit return is inserted for arrow function.",
					flags: [UsedOn([TExpr]), UsedInternally]
				};
			case Include: {name: ":include", doc: "", flags: [Platforms([Cpp])]};
			case InheritDoc: {
					name: ":inheritDoc",
					doc: "Append documentation from a parent field or class (if used without an argument) or from a specified class or field (if used like @:inheritDoc(pack.Some.field)).",
					flags: [UsedOn([TClass, TEnum, TAbstract, TAnyField])]
				};
			case InitPackage: {
					name: ":initPackage",
					doc: "Some weird thing for Genjs we want to remove someday.",
					flags: [Platforms([Js]), UsedInternally]
				};
			case Inline: {
					name: ":inline",
					doc: "Inserted by the parser in case of `inline expr` and `inline function`.",
					flags: [UsedOn([TExpr])]
				};
			case InlineConstructorArgument(_, _): {
					name: ":inlineConstructorArgument",
					doc: "Internally used to mark expressions that were passed as arguments of an inlined constructor.",
					flags: [UsedInternally]
				};
			case InlineObject: {
					name: ":inlineObject",
					doc: "Internally used by inline constructors filter to mark potentially inlineable objects.",
					flags: [UsedInternally]
				};
			case IsVar: {
					name: ":isVar",
					doc: "Forces a physical field to be generated for properties that otherwise would not require one.",
					flags: [
						UsedOn([TClassField]),
						Link("https://haxe.org/manual/class-field-property-rules.html")
					]
				};
			case JavaDefault: {
					name: ":java.default",
					doc: "Equivalent to the default modifier of the Java language",
					flags: [Platforms([Jvm]), UsedOn([TClassField])]
				};
			case JvmSynthetic: {
					name: ":jvm.synthetic",
					doc: "Mark generated class, field or method as synthetic",
					flags: [Platforms([Jvm]), UsedOn([TClass, TEnum, TAnyField])]
				};
			case JsRequire: {
					name: ":jsRequire",
					doc: "Generate JavaScript module require expression for given extern.",
					flags: [
						Platforms([Js]),
						UsedOn([TClass]),
						Link("https://haxe.org/manual/target-javascript-require.html")
					]
				};
			case JsImport: {
					name: ":js.import",
					doc: "Generate ES module import statement for given extern. Produces import lines at the top of the generated JS output.",
					flags: [Platforms([Js]), UsedOn([TClass])]
				};
			case LuaRequire: {
					name: ":luaRequire",
					doc: "Generate Lua module require expression for given extern.",
					flags: [Platforms([Lua]), UsedOn([TClass])]
				};
			case LuaDotMethod: {
					name: ":luaDotMethod",
					doc: "Indicates that the given extern type instance should have dot-style invocation for methods instead of colon.",
					flags: [Platforms([Lua])]
				};
			case Keep: {
					name: ":keep",
					doc: "Causes a field or type to be kept by DCE.",
					flags: [Link("https://haxe.org/manual/cr-dce.html")]
				};
			case KeepInit: {
					name: ":keepInit",
					doc: "Causes a class to be kept by DCE even if all its field are removed.",
					flags: [UsedOn([TClass]), Link("https://haxe.org/manual/cr-dce.html")]
				};
			case KeepSub: {
					name: ":keepSub",
					doc: "Extends `@:keep` metadata to all implementing and extending classes.",
					flags: [UsedOn([TClass]), Link("https://haxe.org/manual/cr-dce.html")]
				};
			case LibType: {
					name: ":libType",
					doc: "Used by `--net-lib` and `--java-lib` to mark a class that should not be checked (overrides, interfaces, etc) by the type loader.",
					flags: [Platforms([Jvm]), UsedOn([TClass]), UsedInternally]
				};
			case LoopLabel: {
					name: ":loopLabel",
					doc: "Mark loop and break expressions with a label to support breaking from within switch.",
					flags: [UsedInternally]
				};
			case Markup: {
					name: ":markup",
					doc: "Used as a result of inline XML parsing.",
					flags: [Link("https://haxe.org/manual/lf-markup.html")]
				};
			case Meta: {name: ":meta", doc: "Internally used to mark a class field as being the metadata field.", flags: [UsedInternally]};
			case MergeBlock: {name: ":mergeBlock", doc: "Merge the annotated block into the current scope.", flags: [UsedOn([TExpr])]};
			case MultiReturn: {
					name: ":multiReturn",
					doc: "Annotates an extern class as the result of multi-return function.",
					flags: [
						Platforms([Lua]),
						UsedOn([TClass]),
						Link("https://haxe.org/manual/target-lua-multireturns.html")
					]
				};
			case MultiType: {
					name: ":multiType",
					doc: "Specifies that an abstract chooses its this-type from its `@:to` functions.",
					flags: [HasParam("Relevant type parameters"), UsedOn([TAbstract])]
				};
			case Native: {
					name: ":native",
					doc: "Rewrites the path of a type or class field during generation.",
					flags: [
						HasParam("Output path"),
						UsedOn([TClass, TEnum, TAbstract, TClassField]),
						Link("https://haxe.org/manual/lf-externs.html")
					]
				};
			case NativeJni: {
					name: ":java.native",
