package core;

import Type as StdType;
import core.Globals.Platform;

// port: translation of MetaList generated by haxe/src/prebuild.ml from src-json/meta.json.
// Enum order follows the pinned input.
enum MetaUsage {
	TClass;
	TClassField;
	TAbstract;
	TAbstractField;
	TEnum;
	TTypedef;
	TAnyField;
	TExpr;
	TTypeParameter;
	TVariable;
}

enum MetaParameter {
	HasParam(value:String);
	Platforms(values:Array<Platform>);
	UsedOn(values:Array<MetaUsage>);
	UsedInternally;
	Link(url:String);
}

enum StrictMeta {
	Abi;
	Access;
	Accessor;
	Allow;
	Analyzer;
	Annotation;
	ArrayAccess;
	Ast;
	AstSource;
	AutoBuild;
	Bind;
	Bitmap;
