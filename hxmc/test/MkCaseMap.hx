import macros.eval.EvalBytesUnicase;

// Writes hxmc/std/hxmc/rt/CaseMap.hx, String.toUpperCase and toLowerCase's
// tables, from the port's copy of Eval's (haxe/src/macros/eval/EvalBytesUnicase.hx:
// the simple case mappings of the BMP, per block of 64 code points):
//   bin/hxmc/hxmc -cp haxe/src -cp hxmc/test --run MkCaseMap
// Each table is runs (lo, hi, stride, delta): the code points lo, lo + stride,
// ... up to hi map to themselves + delta; the others to themselves. Encoded as
// lo's distance from the previous run's hi, hi - lo, stride, delta; base 36,
// comma-separated, a negative number with a leading "-".
class MkCaseMap {
	static function runs(t:haxe.ds.Vector<haxe.ds.Vector<Int>>):Array<Int> {
		var pairs = [];
		for (b in 0...t.length)
			for (k in 0...64) {
				var m = t[b][k];
				if (m != 0) pairs.push({c: b * 64 + k, d: m - (b * 64 + k)});
			}
		var out = [], prevHi = 0, i = 0;
		while (i < pairs.length) {
			var lo = pairs[i].c, d = pairs[i].d;
			var stride = i + 1 < pairs.length && pairs[i + 1].d == d && pairs[i + 1].c - lo <= 2 ? pairs[i + 1].c - lo : 1;
			var j = i;
			while (j + 1 < pairs.length && pairs[j + 1].d == d && pairs[j + 1].c - pairs[j].c == stride)
				j++;
			var hi = pairs[j].c;
			out = out.concat([lo - prevHi, hi - lo, stride, d]);
			prevHi = hi;
			i = j + 1;
		}
		return out;
	}

	static function enc(a:Array<Int>):String
		return [for (v in a) (v < 0 ? "-" : "") + b36(v < 0 ? -v : v)].join(",");

	static function b36(v:Int):String {
		var s = "";
		do {
			var d = v % 36;
			s = String.fromCharCode(d < 10 ? "0".code + d : "a".code + d - 10) + s;
			v = Std.int(v / 36);
		} while (v > 0);
		return s;
	}

	static function main() {
		var up = runs(EvalBytesUnicase._UPPER), low = runs(EvalBytesUnicase._LOWER);
		var src = '// GENERATED by hxmc/test/MkCaseMap.hx from Eval\'s tables (the port\'s
// haxe/src/macros/eval/EvalBytesUnicase.hx): String.toUpperCase and
// toLowerCase beyond ASCII, the simple mappings of the BMP (each code unit
// mapped alone, as Eval and hl map them). Runs (lo, hi, stride, delta),
// decoded on first use (MkCaseMap.hx says how they are encoded).
package hxmc.rt;

class CaseMap {
	static var upper:Null<Array<Int>>;
	static var lower:Null<Array<Int>>;

	// the runs (decoded on first use: this allocates, map does not)
	public static function table(toUpper:Bool):Array<Int> {
		var t = toUpper ? upper : lower;
		if (t == null) {
			t = decode(toUpper ? "${enc(up)}" : "${enc(low)}");
			if (toUpper) upper = t else lower = t;
		}
		return t;
	}

	@:hxmc.noGc public static function map(t:Array<Int>, c:Int):Int {
		// (the last run starting at or below c)
		var a = 0, b = (t.length >> 2) - 1;
		if (b < 0 || c < t[0]) return c;
		while (a < b) {
			var m = (a + b + 1) >> 1;
			if (t[m << 2] <= c) a = m else b = m - 1;
		}
		var k = a << 2;
		return c <= t[k + 1] && (c - t[k]) % t[k + 2] == 0 ? c + t[k + 3] : c;
	}

	// lo, hi, stride, delta per run (lo and hi absolute)
	static function decode(s:String):Array<Int> {
		var out = [], i = 0, n = s.length, prevHi = 0, field = 0;
		while (i < n) {
			var neg = StringTools.fastCodeAt(s, i) == "-".code;
			if (neg) i++;
			var v = 0;
			while (i < n) {
				var c = StringTools.fastCodeAt(s, i++);
				if (c == ",".code) break;
				v = v * 36 + (c <= "9".code ? c - "0".code : c - "a".code + 10);
			}
			if (neg) v = -v;
			switch field {
				case 0: v += prevHi;
				case 1:
					v += out[out.length - 1];
					prevHi = v;
				case _:
			}
			out.push(v);
			field = (field + 1) & 3;
		}
		return out;
	}
}
';
		sys.io.File.saveContent("hxmc/std/hxmc/rt/CaseMap.hx", src);
		Sys.println('hxmc/std/hxmc/rt/CaseMap.hx: ${up.length >> 2} upper runs, ${low.length >> 2} lower runs');
	}
}
