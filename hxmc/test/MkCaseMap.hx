import macros.eval.EvalBytesUnicase;

// Writes hxmc/std/hxmc/rt/CaseMap.hx, String.toUpperCase and toLowerCase's
// tables, from the port's copy of Eval's (haxe/src/macros/eval/EvalBytesUnicase.hx:
// the simple case mappings of the BMP, per block of 64 code points):
//   bin/hxmc/hxmc -cp haxe/src -cp hxmc/test --run MkCaseMap
// Each table is runs (lo, hi, stride, delta): the code points lo, lo + stride,
// ... up to hi map to themselves + delta; the others to themselves. Natively
// read-only data (Mem.words: two int32 per word, little-endian); for WasmGC,
// which has none, encoded as lo's distance from the previous run's hi, hi -
// lo, stride, delta; base 36, comma-separated, a negative number with a
// leading "-".
class MkCaseMap {
	static function runs(t:haxe.ds.Vector<haxe.ds.Vector<Int>>):Array<Int> {
		var pairs = [];
		for (b in 0...t.length)
			for (k in 0...64) {
				var m = t[b][k];
				if (m != 0) pairs.push({c: b * 64 + k, d: m - (b * 64 + k)});
			}
		var out = [], prevHi = 0, i = 0;
		while (i < pairs.length) {
			var lo = pairs[i].c, d = pairs[i].d;
			var stride = i + 1 < pairs.length && pairs[i + 1].d == d && pairs[i + 1].c - lo <= 2 ? pairs[i + 1].c - lo : 1;
			var j = i;
			while (j + 1 < pairs.length && pairs[j + 1].d == d && pairs[j + 1].c - pairs[j].c == stride)
				j++;
			var hi = pairs[j].c;
			out = out.concat([lo - prevHi, hi - lo, stride, d]);
			prevHi = hi;
			i = j + 1;
		}
		return out;
	}

	// absolute runs (lo, hi, stride, delta) as Mem.words' hexadecimal words
	static function words(a:Array<Int>):String {
		var abs = [], prevHi = 0;
		var k = 0;
		while (k < a.length) {
			var lo = prevHi + a[k], hi = lo + a[k + 1];
			abs = abs.concat([lo, hi, a[k + 2], a[k + 3]]);
			prevHi = hi;
			k += 4;
		}
		var out = new StringBuf();
		k = 0;
		while (k < abs.length) {
			out.add(StringTools.hex(abs[k + 1], 8).toLowerCase().substr(-8));
			out.add(StringTools.hex(abs[k], 8).toLowerCase().substr(-8));
			k += 2;
		}
		return out.toString();
	}

	static function enc(a:Array<Int>):String
		return [for (v in a) (v < 0 ? "-" : "") + b36(v < 0 ? -v : v)].join(",");

	static function b36(v:Int):String {
		var s = "";
		do {
			var d = v % 36;
			s = String.fromCharCode(d < 10 ? "0".code + d : "a".code + d - 10) + s;
			v = Std.int(v / 36);
		} while (v > 0);
		return s;
	}

	static function main() {
		var up = runs(EvalBytesUnicase._UPPER), low = runs(EvalBytesUnicase._LOWER);
		var src = '// GENERATED by hxmc/test/MkCaseMap.hx from Eval\'s tables (the port\'s
// haxe/src/macros/eval/EvalBytesUnicase.hx): String.toUpperCase and
// toLowerCase beyond ASCII, the simple mappings of the BMP (each code unit
// mapped alone, as Eval and hl map them). Runs (lo, hi, stride, delta):
// natively read-only data (Mem.words); WasmGC, which has none, decodes them
// into a GC array on first use (MkCaseMap.hx says how they are encoded).
// The search is scoped code (docs/plans/lowlevel.md, "One core, two faces"):
// String\'s case mappings are the GC face, hxmc.scoped.Str\'s the scoped one.
package hxmc.rt;

#if !hxmc.wasm_gc @:hxmc.scoped #end
class CaseMap {
	static inline var UPPER = ${up.length >> 2};
	static inline var LOWER = ${low.length >> 2};

	// the code unit c in upper case (toUpper) or in lower case
	#if !hxmc.wasm_gc @:hxmc.noGc #end public static function map(c:Int, toUpper:Bool):Int {
		if (c < 128) return toUpper ? (c >= 97 && c <= 122 ? c - 32 : c) : (c >= 65 && c <= 90 ? c + 32 : c);
		var t = runs(toUpper);
		// (the last run starting at or below c)
		var a = 0, b = (t.length >> 2) - 1;
		if (b < 0 || c < t[0]) return c;
		while (a < b) {
			var m = (a + b + 1) >> 1;
			if (t[m << 2] <= c) a = m else b = m - 1;
		}
		var k = a << 2;
		return c <= t[k + 1] && (c - t[k]) % t[k + 2] == 0 ? c + t[k + 3] : c;
	}

	#if !hxmc.wasm_gc
	static inline function runs(toUpper:Bool):hxmc.scoped.Slice<Int>
		return toUpper ? new hxmc.scoped.Slice((hxmc.unsafe.Mem.words("${words(up)}", 16) : hxmc.unsafe.Ptr<Int>), 4 * UPPER) : new hxmc.scoped.Slice((hxmc.unsafe.Mem.words("${words(low)}", 16) : hxmc.unsafe.Ptr<Int>), 4 * LOWER);
	#else
	static var upper:Null<Array<Int>>;
	static var lower:Null<Array<Int>>;

	// (decoded on first use)
	static function runs(toUpper:Bool):Array<Int> {
		var t = toUpper ? upper : lower;
		if (t == null) {
			t = decode(toUpper ? "${enc(up)}" : "${enc(low)}");
			if (toUpper) upper = t else lower = t;
		}
		return t;
	}

	// lo, hi, stride, delta per run (lo and hi absolute)
	static function decode(s:String):Array<Int> {
		var out = [], i = 0, n = s.length, prevHi = 0, field = 0;
		while (i < n) {
			var neg = StringTools.fastCodeAt(s, i) == "-".code;
			if (neg) i++;
			var v = 0;
			while (i < n) {
				var c = StringTools.fastCodeAt(s, i++);
				if (c == ",".code) break;
				v = v * 36 + (c <= "9".code ? c - "0".code : c - "a".code + 10);
			}
			if (neg) v = -v;
			switch field {
				case 0: v += prevHi;
				case 1:
					v += out[out.length - 1];
					prevHi = v;
				case _:
			}
			out.push(v);
			field = (field + 1) & 3;
		}
		return out;
	}
	#end
}
';
		sys.io.File.saveContent("hxmc/std/hxmc/rt/CaseMap.hx", src);
		Sys.println('hxmc/std/hxmc/rt/CaseMap.hx: ${up.length >> 2} upper runs, ${low.length >> 2} lower runs');
	}
}
