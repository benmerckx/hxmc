package hxmc;

import sys.FileSystem;
import sys.io.File;

// The hxmc target's std as programs are typed with it (`-cp <out>
// --custom-target hxmc`, given last: the last class path wins), from
// hxmc/std:
//   haxe -cp hxmc/src --run hxmc.MkStd [<hxmc std> <upstream std> <out>]
// (defaults hxmc/std, haxe/upstream/std, bin/hxmc/std). The macro context
// (Eval) shares class paths with the program, so every override of an
// upstream module keeps the original source for Eval:
//   package ...;  #if eval <original> #else <hxmc implementation> #end
// Modules of hxmc's own (the `hxmc` package: the runtime's externs) are
// copied as they are. Files are rewritten only when their content changes;
// a file of <out> no longer made from hxmc/std (its source deleted) is removed.
//
// <out>/hxmc-portable (not a package name: never typed with the program) is
// the class path of the other targets (Eval, JavaScript, ...), which
// HaxeMain adds for them: hxmc/portable (spans over Bytes, docs/interop.md,
// "Spans on other targets") and the modules of hxmc/std that are plain
// Haxe on any target (PORTABLE: the C scalars a kernel's spans hold).
class MkStd {
	static var made:Map<String, Bool>;

	// hxmc/std's modules hxmc-portable copies as they are
	static final PORTABLE = ["UInt8", "Int8", "UInt16", "Int16", "Int32", "UInt32", "Int64", "Float32"].map(n -> 'hxmc/unsafe/$n.hx');

	static function main() {
		var a = Sys.args();
		run(a.length > 0 ? a[0] : "hxmc/std", a.length > 1 ? a[1] : "haxe/upstream/std", a.length > 2 ? a[2] : "bin/hxmc/std");
	}

	public static function run(src:String, std:String, out:String) {
		made = [out + "/.stamp" => true];
		walk(src, "", std, out);
		var portable = haxe.io.Path.directory(src) + "/portable";
		if (FileSystem.exists(portable)) {
			copyTree(portable, "", out + "/hxmc-portable");
			for (r in PORTABLE)
				write(out + "/hxmc-portable/" + r, File.getContent(src + "/" + r));
		}
		prune(out);
		File.saveContent(out + "/.stamp", "");
	}

	// what an earlier run made from a source since deleted: removed, with
	// the directories it leaves empty
	static function prune(dir:String):Bool {
		if (!FileSystem.exists(dir)) return true;
		var empty = true;
		for (n in FileSystem.readDirectory(dir)) {
			var path = dir + "/" + n;
			if (FileSystem.isDirectory(path)) {
				if (prune(path)) FileSystem.deleteDirectory(path) else empty = false;
			} else if (made.exists(path)) empty = false;
			else FileSystem.deleteFile(path);
		}
		return empty;
	}

	static function walk(src:String, rel:String, std:String, out:String) {
		var names = FileSystem.readDirectory(rel == "" ? src : src + "/" + rel);
		names.sort((a, b) -> a < b ? -1 : a > b ? 1 : 0);
		for (n in names) {
			var r = rel == "" ? n : rel + "/" + n;
			if (FileSystem.isDirectory(src + "/" + r)) {
				walk(src, r, std, out);
				continue;
			}
			var ours = File.getContent(src + "/" + r);
			var orig = null;
			for (cand in [std + "/eval/_std/" + r, std + "/" + r])
				if (FileSystem.exists(cand)) {
					orig = File.getContent(cand);
					break;
				}
			if (orig == null || !StringTools.endsWith(r, ".hx")) { // hxmc's own module (e.g. hxmc.Native)
				write(out + "/" + r, ours);
				continue;
			}
			var p = splitPackage(ours);
			var o = splitPackage(orig);
			write(out + "/" + r, '// GENERATED by hxmc/src/hxmc/MkStd.hx from hxmc/std/$r\n${p.pkg}\n#if eval\n${o.body}\n#else\n${p.body}\n#end\n');
		}
	}

	static function copyTree(src:String, rel:String, out:String) {
		var names = FileSystem.readDirectory(rel == "" ? src : src + "/" + rel);
		names.sort((a, b) -> a < b ? -1 : a > b ? 1 : 0);
		for (n in names) {
			var r = rel == "" ? n : rel + "/" + n;
			if (FileSystem.isDirectory(src + "/" + r)) copyTree(src, r, out) else write(out + "/" + r, File.getContent(src + "/" + r));
		}
	}

	static function splitPackage(text:String):{pkg:String, body:String} {
		var re = ~/^[ \t\r\n]*package[ \t]+[A-Za-z0-9_.]*[ \t]*;/m;
		if (!re.match(text)) return {pkg: "", body: text};
		var p = re.matchedPos();
		return {pkg: StringTools.trim(re.matched(0)), body: text.substr(0, p.pos) + text.substr(p.pos + p.len)};
	}

	static function write(path:String, text:String) {
		made[path] = true;
		if (FileSystem.exists(path) && File.getContent(path) == text) return;
		FileSystem.createDirectory(haxe.io.Path.directory(path));
		File.saveContent(path, text);
	}
}
