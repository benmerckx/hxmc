package hxmc.rt;

#if !hxmc.wasm_gc
import hxmc.unsafe.Mem;
#end

// The tables of LibM (pow_data.c, exp_data.c, log.c's, rem_pio2_large.c's
// ipio2) as hexadecimal bit patterns, indexed by entry: the trusted layer
// under the core (docs/plans/lowlevel.md, "Two representations, one core").
// Linear memory: read-only data of the program (Mem.words); WasmGC, which
// has none: the engine's arrays, decoded once.
@:keep @:hxmc.anyHeap
class LibMData {
	static inline var POW_TAB = "";
	static inline var POW_POLY = "bfe0000000000000bfe55555555555603fe00000000000063fe999999959554ebfe555555529a47abff2495b9b4845e93ff0002b8b263fc3";
	static inline var EXP_TAB = "";
	static inline var EXP_POLY = "3fdffffffffffdbd3fc555555555543c3fa55555cf172b913f81111167a4d017";
	static inline var LOG_TAB = "";
	static inline var LOG_TAB_2 = "";
	static inline var LOG_POLY_1 = "bfe00000000000003fd5555555555577bfcffffffffffdcb3fc999999995dd0cbfc55555556745a73fc24924a344de30bfbfffffa4423d653fbc7184282ad6cabfb999eb43b068ff3fb78182f7afd085bfb5521375d145cd";
	static inline var LOG_POLY = "bfe00000000000013fd555555551305bbfcfffffffeb45903fc999b324f10111bfc55575e506c89f";
	static inline var IPIO_2 = "";

	#if hxmc.wasm_gc
	static final powTabA:hxmc.NativeArray<Float> = f64s(POW_TAB);
	static final powPolyA:hxmc.NativeArray<Float> = f64s(POW_POLY);
	static final expTabA:hxmc.NativeArray<hxmc.I64> = words(EXP_TAB, 16);
	static final expPolyA:hxmc.NativeArray<Float> = f64s(EXP_POLY);
	static final logTabA:hxmc.NativeArray<Float> = f64s(LOG_TAB);
	static final logTab2A:hxmc.NativeArray<Float> = f64s(LOG_TAB_2);
	static final logPoly1A:hxmc.NativeArray<Float> = f64s(LOG_POLY_1);
	static final logPolyA:hxmc.NativeArray<Float> = f64s(LOG_POLY);
	static final ipio2A:hxmc.NativeArray<hxmc.I64> = words(IPIO_2, 6);

	public static inline function powTab(i:Int):Float
		return powTabA.unsafeGet(i);

	public static inline function powPoly(i:Int):Float
		return powPolyA.unsafeGet(i);

	public static inline function expTab(i:Int):I64
		return expTabA.unsafeGet(i);

	public static inline function expPoly(i:Int):Float
		return expPolyA.unsafeGet(i);

	public static inline function logTab(i:Int):Float
		return logTabA.unsafeGet(i);

	public static inline function logTab2(i:Int):Float
		return logTab2A.unsafeGet(i);

	public static inline function logPoly1(i:Int):Float
		return logPoly1A.unsafeGet(i);

	public static inline function logPoly(i:Int):Float
		return logPolyA.unsafeGet(i);

	public static inline function ipio2(i:Int):Int
		return ipio2A.unsafeGet(i).toInt();

	// words of `digits` hexadecimal digits each
	static function words(hex:String, digits:Int):hxmc.NativeArray<hxmc.I64> {
		var n = Std.int(hex.length / digits);
		var a = new hxmc.NativeArray<hxmc.I64>(n);
		for (k in 0...n) {
			var v:hxmc.I64 = 0;
			for (j in 0...digits) {
				var c = StringTools.fastCodeAt(hex, k * digits + j);
				v = (v << 4) | (c <= "9".code ? c - "0".code : c - "a".code + 10);
			}
			a.unsafeSet(k, v);
		}
		return a;
	}

	static function f64s(hex:String):hxmc.NativeArray<Float> {
		var w = words(hex, 16);
		var a = new hxmc.NativeArray<Float>(w.length);
		for (k in 0...w.length)
			a.unsafeSet(k, Repr.bitsDouble(w.unsafeGet(k)));
		return a;
	}
	#else
	public static inline function powTab(i:Int):Float
		return Mem.getF64At(Mem.words(POW_TAB, 16), 0, i);

	public static inline function powPoly(i:Int):Float
		return Mem.getF64At(Mem.words(POW_POLY, 16), 0, i);

	public static inline function expTab(i:Int):I64
		return Mem.getI64At(Mem.words(EXP_TAB, 16), 0, i);

	public static inline function expPoly(i:Int):Float
		return Mem.getF64At(Mem.words(EXP_POLY, 16), 0, i);

	public static inline function logTab(i:Int):Float
		return Mem.getF64At(Mem.words(LOG_TAB, 16), 0, i);

	public static inline function logTab2(i:Int):Float
		return Mem.getF64At(Mem.words(LOG_TAB_2, 16), 0, i);

	public static inline function logPoly1(i:Int):Float
		return Mem.getF64At(Mem.words(LOG_POLY_1, 16), 0, i);

	public static inline function logPoly(i:Int):Float
		return Mem.getF64At(Mem.words(LOG_POLY, 16), 0, i);

	public static inline function ipio2(i:Int):Int
		return Mem.getI64At(Mem.words(IPIO_2, 6), 0, i).toInt();
	#end
}
